<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sharedControls="clr-namespace:Skua.Shared.Avalonia.Controls.Buttons;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.Manager.Avalonia.UserControls.ClientUpdatesUserControl"
             d:DesignWidth="900"
             d:DesignHeight="600"
             mc:Ignorable="d">
    <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <sharedControls:IconTextButton Command="{Binding RefreshCommand}"
                                           IconKind="Refresh"
                                           Text="Refresh" />
            <sharedControls:IconTextButton Command="{Binding UpdateCommand}"
                                           IsEnabled="{Binding UpdateVisible}"
                                           IconKind="ArrowUpBold"
                                           Text="Update Latest" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,8,0,8" Spacing="4">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Current, StringFormat=Current: {0}}" />
            <TextBlock Text="{Binding ProgressStatus}" IsVisible="{Binding IsBusy}" />
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="6" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="16"
                IsVisible="{Binding UpdateVisible}"
                Classes="card"
                CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Text="Velopack update available" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Latest, StringFormat=Version: {0}}" />
                <TextBlock Text="Use Update Latest to download and restart Skua." />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="Manage client versions from this tab."
                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
    </Grid>
</UserControl>

