<UserControl
    x:Class="Skua.WPF.UserControls.MessagingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:vms="clr-namespace:Skua.Core.ViewModels.Manager;assembly=Skua.Core"
    xmlns:wpf="clr-namespace:Skua.WPF"
    d:DataContext="{d:DesignInstance vms:MessagingViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedClients" Source="{Binding ConnectedClients}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Group" />
                <scm:SortDescription PropertyName="Username" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Connected Clients Roster -->
        <DockPanel Grid.Column="0">
            <TextBlock
                DockPanel.Dock="Top"
                Margin="6"
                FontSize="14"
                FontWeight="Medium"
                Text="Connected Clients" />
            <ListBox
                ItemsSource="{Binding Source={StaticResource GroupedClients}}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4,0,2"
                                    Padding="6,2"
                                    Background="{DynamicResource MaterialDesignDivider}"
                                    CornerRadius="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource MaterialDesignBody}"
                                        Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vms:ConnectedClientViewModel}">
                        <StackPanel Margin="2" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Account" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                <Setter Property="Kind" Value="Crown" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDivider}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Username}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                Text="{Binding ClientId, StringFormat='#{0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: Message Feed -->
        <DockPanel Grid.Column="1" Margin="6,0,0,0">
            <!-- Filter bar -->
            <Grid DockPanel.Dock="Top" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="Filter messages..."
                    Text="{Binding MessageFilter, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="100"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding AvailableGroups}"
                    SelectedItem="{Binding SelectedGroup}" />
                <ToggleButton
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ShowPayload}"
                    Style="{StaticResource MaterialDesignFlatToggleButton}"
                    ToolTip="Show payload JSON">
                    <materialDesign:PackIcon Kind="CodeBraces" />
                </ToggleButton>
            </Grid>

            <!-- Buttons -->
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="0,6,3,0"
                    Command="{Binding ClearMessagesCommand}"
                    Content="Clear" />
                <Button
                    Grid.Column="1"
                    Margin="3,6,0,0"
                    Command="{Binding CopyMessagesCommand}"
                    Content="Copy" />
            </Grid>

            <!-- Message list -->
            <ListBox
                ItemsSource="{Binding Messages}"
                SelectionMode="Multiple"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.CacheLength="10,10"
                VirtualizingPanel.CacheLengthUnit="Item"
                ScrollViewer.CanContentScroll="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <b:Interaction.Behaviors>
                    <wpf:ListBoxCopySelectedBehavior />
                    <wpf:ListBoxScrollToCaretBehavior />
                </b:Interaction.Behaviors>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
